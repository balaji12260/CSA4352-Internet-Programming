<!DOCTYPE html>
<html>
<head>
    <title>Online Flight Reservation System</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #e6f7ff;
            margin: 0;
            padding: 0;
        }

        header {
            background-color: #0066cc;
            color: white;
            text-align: center;
            padding: 15px;
        }

        .container {
            width: 50%;
            margin: 20px auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px gray;
        }

        h2 {
            text-align: center;
            color: #0066cc;
        }

        label {
            font-weight: bold;
        }

        input, select {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            margin-bottom: 15px;
        }

        button {
            width: 100%;
            padding: 10px;
            background-color: #0066cc;
            color: white;
            border: none;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            background-color: #004d99;
        }

        #message {
            text-align: center;
            color: green;
            font-weight: bold;
            margin-top: 15px;
        }
    </style>

    <script>
        function reserveFlight() {
            let name = document.getElementById("name").value;
            let from = document.getElementById("from").value;
            let to = document.getElementById("to").value;
            let date = document.getElementById("date").value;

            if (name === "" || from === "" || to === "" || date === "") {
                alert("Please fill all the fields.");
                return;
            }

            document.getElementById("message").innerHTML =
                "Flight Reservation Successful!";
        }
    </script>
</head>
<body>

<header>
    <h1>Online Flight Reservation System</h1>
</header>

<div class="container">
    <h2>Book Your Flight</h2>

    <label>Passenger Name:</label>
    <input type="text" id="name" placeholder="Enter your name">

    <label>From:</label>
    <input type="text" id="from" placeholder="Departure City">

    <label>To:</label>
    <input type="text" id="to" placeholder="Destination City">

    <label>Travel Date:</label>
    <input type="date" id="date">

    <label>Class:</label>
    <select id="class">
        <option>Economy</option>
        <option>Business</option>
        <option>First Class</option>
    </select>

    <button onclick="reserveFlight()">Reserve Flight</button>

    <p id="message"></p>
</div>

</body>
</html>
