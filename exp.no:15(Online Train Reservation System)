<!DOCTYPE html>
<html>
<head>
    <title>Online Train Reservation System</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #e6ffe6;
            margin: 0;
            padding: 0;
        }

        header {
            background-color: #198754;
            color: white;
            text-align: center;
            padding: 15px;
        }

        .container {
            width: 50%;
            margin: 20px auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
        }

        h2 {
            text-align: center;
            color: #198754;
        }

        label {
            font-weight: bold;
        }

        input, select {
            width: 100%;
            padding: 8px;
            margin: 8px 0 15px;
        }

        button {
            width: 100%;
            padding: 10px;
            background-color: #198754;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            background-color: #146c43;
        }

        #message {
            text-align: center;
            color: green;
            font-weight: bold;
            margin-top: 15px;
        }
    </style>

    <script>
        function bookTrain() {
            let name = document.getElementById("name").value;
            let from = document.getElementById("from").value;
            let to = document.getElementById("to").value;
            let date = document.getElementById("date").value;

            if (name === "" || from === "" || to === "" || date === "") {
                alert("Please fill all fields.");
                return;
            }

            document.getElementById("message").innerHTML =
                "Train Ticket Booked Successfully!";
        }
    </script>
</head>

<body>

<header>
    <h1>Online Train Reservation System</h1>
</header>

<div class="container">

    <h2>Book Your Train Ticket</h2>

    <label>Passenger Name:</label>
    <input type="text" id="name" placeholder="Enter your name">

    <label>From Station:</label>
    <input type="text" id="from" placeholder="Departure station">

    <label>To Station:</label>
    <input type="text" id="to" placeholder="Destination station">

    <label>Journey Date:</label>
    <input type="date" id="date">

    <button onclick="bookTrain()">Book Ticket</button>

    <p id="message"></p>

</div>

</body>
</html>
